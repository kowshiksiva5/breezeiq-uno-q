# Copy to .env and fill in. .env is gitignored.
#   cp .env.example .env && chmod 600 .env
#
# Nothing here is needed to run the simulated demo or read the code. It is
# needed only to command real devices.

# ── Home Assistant — the AC plug and the light ─────────────────────────
# HA speaks Tuya so BreezeIQ never has to. Token: HA > your name (bottom
# left) > Security > Long-lived access tokens. Shown once.
HA_URL=http://127.0.0.1:8123
HA_TOKEN=
HA_AC_ENTITY=
HA_LIGHT_ENTITY=
# Optional: a metering plug's power/energy entities, for measured watts.
HA_AC_POWER_ENTITY=
HA_AC_ENERGY_ENTITY=

# ── Atomberg — the ceiling fan, the rung that does the real work ───────
# Generated in the Atomberg Home app under Developer Mode, not the website.
# Hard vendor limit: 100 API calls/day. State comes free over UDP 5625, so
# quota is spent only when the ladder actually changes something.
ATOMBERG_API_KEY=
ATOMBERG_REFRESH_TOKEN=
ATOMBERG_FAN_ID=

# ── Safety gates — both must be 1 before anything real is switched ─────
# Dry-run is the default on purpose: a fresh clone must not be able to turn
# someone's AC on. Set the second only after dry-run output, entity mapping,
# independent readback, rate limits and the compressor hold have all passed.
BREEZEIQ_LIVE=0
BREEZEIQ_SAFETY_VALIDATED=0
# Automatic and manual control are gated separately.
BREEZEIQ_AUTOMATION_CONTROL_ENABLED=0
BREEZEIQ_MANUAL_CONTROL_ENABLED=0

# ── Runtime ────────────────────────────────────────────────────────────
# On the UNO Q, Linux reads its own STM32 through the board-local Arduino
# Router. Use `stm32-serial` only on a dev host with a USB serial cable,
# `mock` for no hardware at all.
BREEZEIQ_SOURCE=router
BREEZEIQ_DB=/home/arduino/ArduinoApps/breezeiq/data/telemetry.sqlite3
# The AC digital twin models the room's response to a real AC switch. Its
# controls never call a device backend.
BREEZEIQ_AC_TWIN_ENABLED=1
BREEZEIQ_TWIN_SETPOINT_C=24
